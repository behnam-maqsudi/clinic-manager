{
  "compilerOptions": {
    "target": "ES2023",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist-server",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/db.ts", "src/git-updater.ts", "src/server.ts", "src/electron/**/*.ts", "src/shared/**/*.ts"]
}
