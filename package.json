{
  "name": "clinic-manager",
  "version": "1.0.0",
  "description": "سیستم مدیریت مراجعه‌کنندگان مطب دکتر بهامین جهانیان با قابلیت آپلود آزمایش از موبایل، شبکه داخلی و بروزرسانی گیت",
  "main": "dist-server/electron/main.js",
  "scripts": {
    "start": "node dist-server/server.js",
    "dev": "vite",
    "electron": "npm run build && node -e \"const{spawn}=require('node:child_process');const env={...process.env};delete env.ELECTRON_RUN_AS_NODE;const c=spawn(require('electron'),['.'],{stdio:'inherit',env});c.on('exit',code=>process.exit(code??0));\"",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build": "npm run typecheck && npm run build:server && npm run build:client",
    "test": "playwright test"
  },
  "build": {
    "appId": "com.jahanian.clinicmanager",
    "productName": "Clinic Manager - Dr Jahanian",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.medical"
    }
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^1.82.0",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-date-object": "^2.1.9",
    "react-dom": "^19.3.1",
    "react-multi-date-picker": "^4.5.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
}
