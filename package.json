{
  "name": "clinic-manager",
  "version": "1.0.0",
  "description": "سیستم مدیریت مراجعه‌کنندگان مطب دکتر بهامین جهانیان با قابلیت آپلود آزمایش از موبایل، شبکه داخلی و بروزرسانی گیت",
  "main": "dist-server/server.js",
  "scripts": {
    "start": "node dist-server/server.js",
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build": "npm run typecheck && npm run build:server && npm run build:client"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^1.82.0",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
}
